{
  "$schema": "box-model.schema.json",
  "units": "m",
  "parameters": {
    "width": 1.2,
    "depth": 0.8,
    "height": 0.8,
    "top_thickness": 0.08,
    "leg_width": 0.08,
    "inset": 0.04
  },
  "mesh_size": 0.04,
  "parts": [
    {"name": "tabletop", "origin": [0, "height - top_thickness", 0],
     "size": ["width", "top_thickness", "depth"]},
    {"name": "front_left_leg", "origin": ["inset", 0, "inset"],
     "size": ["leg_width", "height - top_thickness", "leg_width"]},
    {"name": "front_right_leg", "origin": ["width - inset - leg_width", 0, "inset"],
     "size": ["leg_width", "height - top_thickness", "leg_width"]},
    {"name": "back_left_leg", "origin": ["inset", 0, "depth - inset - leg_width"],
     "size": ["leg_width", "height - top_thickness", "leg_width"]},
    {"name": "back_right_leg", "origin": ["width - inset - leg_width", 0, "depth - inset - leg_width"],
     "size": ["leg_width", "height - top_thickness", "leg_width"]}
  ],
  "groups": {
    "feet": {"parts": ["front_left_leg", "front_right_leg", "back_left_leg", "back_right_leg"],
             "face": "ymin"},
    "load_surface": {"parts": ["tabletop"], "face": "ymax"}
  },
  "material": {"young": 70000.0, "poisson": 0.3},
  "constraints": [
    {"select": {"group": "feet"}, "displacement": [0, 0, 0]}
  ],
  "loads": [
    {"select": {"group": "load_surface"}, "force": [0, -1000, 0], "distribution": "total"}
  ]
}
